PORT=4173
HOST=127.0.0.1
# Em produção use HTTPS, NODE_ENV=production, HOST=0.0.0.0 e senha longa.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=substitua-por-uma-senha-forte-de-pelo-menos-10-caracteres
# APP_ORIGIN=https://seu-dominio.com.br
DATA_DIR=.data

# PostgreSQL / Neon. Sem URL, usa JSON local apenas para desenvolvimento.
DATABASE_URL=
# Antes do primeiro início com Neon, execute npm run db:migrate.

# Vercel Blob (armazenamento principal de fotos).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_PUBLIC_URL=

# Alternativa opcional S3. Sem Blob/S3, fotos ficam em DATA_DIR/uploads.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Origem pública HTTPS ou domínio CDN do bucket, sem barra final.
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
