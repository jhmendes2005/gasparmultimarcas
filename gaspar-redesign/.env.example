PORT=4173
HOST=127.0.0.1
# Em produção use HTTPS, NODE_ENV=production, HOST=0.0.0.0 e senha longa.
# ADMIN_PASSWORD=substitua-por-uma-senha-forte-de-pelo-menos-12-caracteres
# APP_ORIGIN=https://seu-dominio.com.br
DATA_DIR=.data

# Opcionais: sem estas variáveis, uploads ficam em DATA_DIR/uploads.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Origem pública HTTPS ou domínio CDN do bucket, sem barra final.
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
